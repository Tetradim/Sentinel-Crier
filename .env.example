CRIER_ACCESS_TOKEN=
DISCORD_WEBHOOK_URL=
CRIER_DELIVERY_ENABLED=false
CRIER_WEBULL_VERIFIED=false
CRIER_WEBULL_PRICE_MODE=
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=
WEBULL_REGION=us
WEBULL_ENV=sandbox
