# Python CLI reads process environment. Docker Compose loads this file.
CRIER_DATA_DIR=/app/data
# Leave blank to generate data/access-token. Otherwise use 32+ random characters.
CRIER_ACCESS_TOKEN=
DISCORD_WEBHOOK_URL=
CRIER_DELIVERY_ENABLED=false
# One application: none, webull, tradier, alpaca. Receipts work with none.
CRIER_MONITOR=none
# Confirm the Discord destination and review queued alerts before enabling delivery.
CRIER_PUBLISHER_VERIFIED=false
# Optional separate observer integration. Use a DIFFERENT 32+ character random key.
CRIER_INTAKE_KEY=
CRIER_INTAKE_VERIFIED=false
CRIER_WEBULL_VERIFIED=false
CRIER_WEBULL_PRICE_MODE=
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=
WEBULL_REGION=us
WEBULL_ENV=sandbox
TRADIER_ACCESS_TOKEN=
TRADIER_ACCOUNT_ID=
TRADIER_ENV=sandbox
CRIER_TRADIER_VERIFIED=false

# Official Alpaca fill monitor: paper first; live requires explicit selection and live keys.
ALPACA_ENV=paper
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Optional direct mirroring receiver (separate account from the source monitor)
# CRIER_MIRROR_ENV=paper
# CRIER_MIRROR_ALPACA_KEY=
# CRIER_MIRROR_ALPACA_SECRET=

# Submission-time trading device (optional; relay-only server needs no broker credentials)
# CRIER_INTENT_ENV=paper
# CRIER_INTENT_ALPACA_KEY=
# CRIER_INTENT_ALPACA_SECRET=
# CRIER_INTENT_ALPACA_ACCOUNT=
