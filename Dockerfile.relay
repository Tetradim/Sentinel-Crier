FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 CRIER_DATA_DIR=/var/data/crier
WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY crier ./crier
RUN pip install --no-cache-dir . && useradd --uid 10001 --create-home crier && mkdir -p /var/data/crier && chown -R crier:crier /var/data/crier
USER crier
EXPOSE 8765
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD python -c "import os,urllib.request; urllib.request.urlopen('http://127.0.0.1:'+os.getenv('PORT','8765')+'/health',timeout=4)"
CMD ["python", "-m", "crier.connection_server"]
